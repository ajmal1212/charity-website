---
// Basic Dark Call To Action section
// ------------
// Description: A centered call to action section inviting visitors to donate, with a background photo and a button.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import CTA from '../../ui/CTA.astro'
import Button from '../../ui/Button.astro'
import ChipNotification from '../../ui/ChipNotification.astro'
import { Icon } from 'astro-icon/components'
---

<Section>
	<Row>
		<Col span="1" />
		<Col span="10">
			<CTA
				title="Support a Cause Close to Your Heart"
				text="Every contribution, big or small, helps us provide education, food, clothing, and care to those who need it most. One act of generosity can make a world of difference."
				mode="dark"
				bg={{ src: '/gallery/food-service-elders-1.jpeg' }}
			>
				<ChipNotification radius="rounded-full" classes="mb-6 box">
					<Icon name="heart" class="ml-3 h-5 w-5 text-primary-400" slot="button" />
					<!-- <span>Registered under Sec.12A of the Income Tax Act, 1961</span> -->
				</ChipNotification>
				<Button size="lg" style="primary" link="/donate"> Donate Now </Button>
			</CTA>
		</Col>
		<Col span="1" />
	</Row>
</Section>
