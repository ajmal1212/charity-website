---
// Contact Info Cards grid Section
// ------------
// Description: A grid of cards with the trust's direct contact information in a 4 column layout.
// Properties:
// - classes: Additional classes to be added to the Section

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/BasicCard.astro'

// 	Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Section id="requests" classes={classes}>
	<Row>
		<Col span="3">
			<Card
				title="Call Us"
				subtitle="+91 9176 91 71 61"
				icon="device-phone-mobile"
				classes="text-center dark:!bg-neutral-800/50"
				link="tel:+919176917161"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Email Us"
				subtitle="pslnt@yahoo.com"
				icon="envelope"
				classes="text-center dark:!bg-neutral-800/50"
				link="mailto:pslnt@yahoo.com"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Visit Us"
				subtitle={`Flat No. 101, "A" Block, Ramani's SRISHTI Apartment, 291, Trichy Road, Singanallur, Coimbatore - 641 005`}
				icon="map-pin"
				classes="text-center dark:!bg-neutral-800/50"
			/>
		</Col>
		<Col span="3" classes="flex flex-col gap-6">
			<Card
				title="WhatsApp Us"
				subtitle="+91 9176 91 71 61"
				icon="whatsapp-icon"
				classes="text-center dark:!bg-neutral-800/50"
				link="https://wa.me/919176917161"
			/>
		</Col>
	</Row>
</Section>
