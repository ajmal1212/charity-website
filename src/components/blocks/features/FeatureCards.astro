---
// Focus Areas grid Section
// ------------
// Description: A grid of cards presenting the trust's core focus areas in a 4 column layout.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/BasicCard.astro'
---

<Section id="features">
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty">How We <strong>Serve</strong> the Community</h2>
			<p class="pb-0 text-lg">
				We uplift disadvantaged communities in Coimbatore through education, essentials, clothing,
				and care for those who need it most.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="3">
			<Card
				title="Girl Child Education"
				subtitle="Financial assistance for deserving girl students to help them pursue quality education without financial barriers."
				icon="book"
				classes="text-center h-full dark:!bg-neutral-800/50"
				link="/about"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Student Essentials"
				subtitle="Food, clothing, study materials, and other basic necessities to enable uninterrupted learning for underprivileged students."
				icon="gift"
				classes="text-center h-full dark:!bg-neutral-800/50"
				link="/about"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Clothing for the Needy"
				subtitle="Donating clothes to destitute and economically disadvantaged individuals, restoring dignity and improving their quality of life."
				icon="heart"
				classes="text-center h-full dark:!bg-neutral-800/50"
				link="/about"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Food & Elder Care"
				subtitle="Providing nutritious food and essential support to destitute residents of orphanages and children's homes."
				icon="user-group"
				classes="text-center h-full dark:!bg-neutral-800/50"
				link="/about"
			/>
		</Col>
	</Row>
</Section>
