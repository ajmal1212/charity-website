---
// Home page Hero Section
// ------------
// Description: A split hero section that introduces the trust, with a registration badge, title, text, and action buttons on the left, and a photo on the right.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import ChipNotification from '../../ui/ChipNotification.astro'
import { Icon } from 'astro-icon/components'
import Button from '../../ui/Button.astro'
---

<Section id="intro" classes="bg-neutral-50 dark:bg-neutral-900">
	<Row>
		<Col span="6" classes="self-center">
			<ChipNotification radius="rounded-full" classes="mb-6">
				<Icon name="heart" class="ml-3 h-5 w-5 text-primary-500" slot="button" />
				Registered Charitable Trust &middot; DARPAN ID: TN/2025/0490055
			</ChipNotification>
			<h1>Empowering Lives with <strong>Dignity</strong> and Hope</h1>

			<p class="pb-0 text-lg">
				PICHUMANI SRI LAKSHMI NARASIMHAN (PSLN) TRUST was founded in August 2024 in Coimbatore to
				serve the underprivileged through education, food, clothing, and other humanitarian needs.
			</p>
			<div class="flex flex-wrap gap-4">
				<Button size="lg" link="/donate">Donate Now</Button>
				<Button size="lg" style="secondary" link="/about">Learn About Us</Button>
			</div>
		</Col>
		<Col span="6" classes="self-center">
			<img
				src="/gallery/home-visit-donation-2.jpeg"
				alt="PSLN Trust volunteers distributing essentials to elderly residents"
				class="rounded shadow-2xl shadow-neutral-200 dark:shadow-neutral-950"
				loading="eager"
			/>
		</Col>
	</Row>
</Section>
