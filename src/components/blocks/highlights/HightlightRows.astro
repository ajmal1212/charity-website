---
// Highlights Section
// ------------
// Description: A section with multiple text and image rows introducing our vision, mission, and commitment.

// Components
// - UI
import TextImage from '../basic/TextImage.astro'

type HighlightBlock = {
	title: string
	text: string
	image: string
	imagePosition: 'left' | 'right'
}
const highlightBlocks: HighlightBlock[] = [
	{
		title: 'Our <strong>Vision</strong>',
		text: 'To build a compassionate and equitable society where every girl has access to quality education, every underprivileged child is empowered to realize their potential, and every vulnerable individual is treated with dignity, care, and respect through meaningful humanitarian initiatives.',
		image: '/gallery/independence-day-gathering.jpeg',
		imagePosition: 'right'
	},
	{
		title: '<strong>Reaching</strong> Those Who Need It Most',
		text: 'We provide nutritious food and essential support to destitute residents of orphanages and children’s homes, ensuring their health and well-being are never overlooked.',
		image: '/gallery/food-service-elders-3.jpeg',
		imagePosition: 'left'
	},
	{
		title: 'Our <strong>Commitment</strong>',
		text: 'We are committed to creating opportunities that transform lives through education, nourishment, clothing, and compassionate care. Working together with donors, volunteers, and well-wishers, we strive to build a future where every child has the opportunity to learn, every girl has the confidence to pursue her dreams, and every needy individual experiences hope, dignity, and a better quality of life.',
		image: '/gallery/home-visit-donation-1.jpeg',
		imagePosition: 'right'
	}
]
---

{
	highlightBlocks.map((highlight, key) => (
		<TextImage
			id={`highlight-${key}`}
			title={highlight.title}
			text={highlight.text}
			image={{ src: highlight.image }}
			mobileImage={{ src: highlight.image }}
			imagePosition={highlight.imagePosition}
			classes={key === 0 ? '!pb-0' : key === highlightBlocks.length - 1 ? '!pt-0' : '!py-0'}
		/>
	))
}
