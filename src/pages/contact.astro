---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHeader.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'
import ContactCards from '../components/blocks/contact/ContactCards.astro'

// Content
// - SEO
const SEO = {
	title: 'Contact Us | PSLN Trust',
	description:
		'Get in touch with PSLN Trust. Whether you have questions about our initiatives, want to get involved, or wish to donate, reach out to us via phone, email, or WhatsApp.'
}
// - Page Header
const header = {
	title: 'Get in <strong>Touch</strong>',
	text: "We'd love to hear from you. Whether you have questions about our initiatives, want to get involved, or simply wish to learn more about the work we do at PSLN Trust, please feel free to reach out. One act of generosity can make a world of difference — support a cause close to your heart and make a difference in someone's life today."
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<ContactCards />
	<CTA />
</Layout>
