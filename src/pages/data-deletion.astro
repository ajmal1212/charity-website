---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import Row from '../components/ui/Row.astro'
import Col from '../components/ui/Col.astro'

// Content
// - SEO
const SEO = {
	title: 'Data Deletion | PSLN Trust',
	description: 'How to request deletion of any personal information you have shared with PSLN Trust.'
}
// - Page Header
const header = {
	title: 'Data <strong>Deletion</strong>',
	text: 'How to request removal of any personal information you have shared with us.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<Section>
		<Row>
			<Col span="8" classes="mx-auto basic-text">
				<h3>What Data We Hold</h3>
				<p>
					This website has no user accounts and no sign-up forms. The only personal information we
					hold is what you have shared with us directly — for example your name, phone number, or
					email address, if you contacted us about donating or volunteering.
				</p>

				<h3>How to Request Deletion</h3>
				<p>To request that we delete any personal information we hold about you, please contact us:</p>
				<ul>
					<li>
						Email: <a href="mailto:pslnt@yahoo.com">pslnt@yahoo.com</a> with the subject "Data
						Deletion Request"
					</li>
					<li>
						Phone / WhatsApp: <a href="tel:+919176917161">+91 9176 91 71 61</a>
					</li>
				</ul>
				<p>
					Please include your name and the phone number or email address you used to contact us,
					so we can locate and remove the correct record.
				</p>

				<h3>Processing Time</h3>
				<p class="mb-0">We will process your request within 7 working days.</p>
			</Col>
		</Row>
	</Section>
</Layout>
