---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHeader.astro'
import FAQ from '../components/blocks/FAQ/FaqSticky.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'

// Data
import faqData from '../data/json-files/faqData.json'
// - FAQ Categories
const faqAbout = faqData.filter((faq) => faq.category === 'about')
const faqDonations = faqData.filter((faq) => faq.category === 'donations')

// Content
// - SEO
const SEO = {
	title: 'FAQ | PSLN Trust',
	description:
		'Answers to common questions about PSLN Trust — who we are, who we help, and how to donate.'
}
// - Page Header
const header = {
	title: 'Frequently Asked <strong>Questions</strong>',
	text: 'Find answers to common questions about PSLN Trust and how you can support our work.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<FAQ
		title="About the Trust"
		text="Learn more about PSLN Trust, our registration, and who we serve."
		data={faqAbout}
	/>
	<FAQ
		title="Donations"
		text="Everything you need to know about supporting our work."
		data={faqDonations}
		classes="bg-neutral-50 dark:bg-neutral-900"
	/>
	<CTA />
</Layout>
