---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHeader.astro'
import Section from '../components/ui/Section.astro'
import Row from '../components/ui/Row.astro'
import Col from '../components/ui/Col.astro'

// Content
// - SEO
const SEO = {
	title: 'Privacy Policy | PSLN Trust',
	description: 'How PSLN Trust collects, uses, and protects the information you share with us.'
}
// - Page Header
const header = {
	title: 'Privacy <strong>Policy</strong>',
	text: 'This policy explains how PICHUMANI SRI LAKSHMI NARASIMHAN (PSLN) TRUST handles information you share with us.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<Section>
		<Row>
			<Col span="8" classes="mx-auto basic-text">
				<h3>Information We Collect</h3>
				<p>
					This website does not require you to create an account or fill out any form. We only
					receive personal information — such as your name, phone number, or email address — if
					you choose to share it directly with us by phone, email, or WhatsApp, for example when
					you reach out about donating or volunteering.
				</p>

				<h3>How We Use Your Information</h3>
				<p>
					Any information you share with us directly is used solely to respond to your enquiry,
					coordinate a donation, or keep you informed about our work, and only with your consent.
				</p>

				<h3>Data Sharing</h3>
				<p>
					We do not sell, rent, or trade your personal information to any third party. Donation
					transactions made via bank transfer or UPI are processed directly by your bank or UPI
					provider, in accordance with their own privacy practices.
				</p>

				<h3>Data Security</h3>
				<p>
					We take reasonable measures to keep any information you share with us secure. However,
					no method of communication over phone, email, or the internet is completely secure.
				</p>

				<h3>Your Rights</h3>
				<p>
					You may ask us to correct or delete any personal information you have shared with us at
					any time. See our <a href="/data-deletion">Data Deletion</a> page for details.
				</p>

				<h3>Changes to This Policy</h3>
				<p>
					We may update this policy from time to time. Any changes will be posted on this page.
				</p>

				<h3>Contact Us</h3>
				<p class="mb-0">
					If you have any questions about this policy, please contact us at
					<a href="mailto:pslnt@yahoo.com">pslnt@yahoo.com</a> or call
					<a href="tel:+919176917161">+91 9176 91 71 61</a>.
				</p>
			</Col>
		</Row>
	</Section>
</Layout>
