---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import SidebarContent from '../components/blocks/basic/StickySidebar.astro'
import Hero from '../components/blocks/hero/PageHeader.astro'

// Content
// - SEO
const SEO = {
	title: 'Terms & Conditions | PSLN Trust',
	description: 'Terms and conditions for using the PSLN Trust website.'
}
// - Page Header
const header = {
	title: 'Terms &amp; <strong>Conditions</strong>',
	text: 'Please read these terms carefully before using this website or making a donation.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<SidebarContent>
		<div slot="sidebar">
			<h3>Introduction</h3>
			<p>These terms govern your use of the PSLN Trust website.</p>
		</div>
		<div class="basic-text">
			<h4>About This Website</h4>
			<p>
				This website belongs to PICHUMANI SRI LAKSHMI NARASIMHAN (PSLN) TRUST and is provided to
				share information about our charitable work and to accept voluntary donations. By using
				this website, you agree to these terms.
			</p>

			<h4>Use of Content</h4>
			<p>
				The content on this website, including text, photographs of our activities, and our logo,
				is the property of PSLN Trust and is provided for informational purposes. You may not
				reproduce or use it for commercial purposes without our written permission.
			</p>

			<h4>Accuracy of Information</h4>
			<p>
				We make every effort to keep the information on this website accurate and up to date,
				including our bank and contact details. If you notice any discrepancy, please contact us at
				<a href="mailto:pslnt@yahoo.com">pslnt@yahoo.com</a> before making a donation.
			</p>
		</div>
	</SidebarContent>
	<SidebarContent classes="bg-neutral-50 dark:bg-neutral-900">
		<div slot="sidebar">
			<h3>Donations</h3>
			<p>How contributions to PSLN Trust are treated.</p>
		</div>
		<div class="basic-text">
			<h4>Voluntary Contributions</h4>
			<p>
				All donations made to PSLN Trust are voluntary. We depend entirely on voluntary
				contributions for our charitable work, and every contribution is used judiciously for our
				education, food, clothing, and humanitarian support initiatives.
			</p>

			<h4>Refunds</h4>
			<p>
				Donations are generally non-refundable once processed, except in the case of a genuine
				error such as a duplicate or incorrect transaction. In such cases, please contact us at
				<a href="mailto:pslnt@yahoo.com">pslnt@yahoo.com</a> or call
				<a href="tel:+919176917161">+91 9176 91 71 61</a>, and we will review your request.
			</p>

			<h4>Third-Party Payment Channels</h4>
			<p>
				Donations made via UPI or bank transfer are processed by your bank or UPI provider. PSLN
				Trust is not responsible for any issues arising from those third-party payment services.
			</p>
		</div>
	</SidebarContent>
	<SidebarContent>
		<div slot="sidebar">
			<h3>General</h3>
			<p>Liability and governing law.</p>
		</div>
		<div class="basic-text">
			<h4>Website Availability</h4>
			<p>
				This website is provided on an "as is" basis. We do not guarantee that it will be
				available without interruption or free of errors.
			</p>

			<h4>Governing Law</h4>
			<p>
				These terms are governed by the laws of India, and any disputes will be subject to the
				jurisdiction of the courts in Coimbatore, Tamil Nadu.
			</p>

			<h4>Contact</h4>
			<p class="mb-0">
				If you have any questions about these terms, please contact us at
				<a href="mailto:pslnt@yahoo.com">pslnt@yahoo.com</a>.
			</p>
		</div>
	</SidebarContent>
</Layout>
